{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "ghost:vessel_zoglin",
   "materials": {
    "default": "zoglin",
    "ghost_eyes": "breeze_eyes"
   },
   "textures": {
    "default": "textures/entity/zoglin/zoglin",
    "baby": "textures/entity/zoglin/zoglin_baby",
    "ghost_eyes": "textures/entity/ghost_eyes"
   },
   "geometry": {
    "default": "geometry.ghost.zoglin.default",
    "baby": "geometry.ghost.zoglin.baby",
    "ghost_eyes": "geometry.ghost.zoglin.eyes"
   },
   "scripts": {
    "pre_animation": [
     "variable.tcos_right_side = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
     "variable.tcos_left_side = -variable.tcos_right_side;",
     "variable.attack_head_rot =  Math.sin(variable.attack_time * 180.0) * -37.3;"
    ],
    "animate": [
     "walk",
     "look_at_target",
     {
      "attack": "variable.has_target && variable.attack_time >= 0.0"
     },
     "ghost_corpse_ctrl"
    ],
    "scale": "query.is_baby ? 2.0 : 1.0"
   },
   "animations": {
    "walk": "animation.hoglin.walk",
    "look_at_target": "animation.hoglin.look_at_target",
    "attack": "animation.hoglin.attack",
    "hoglin_baby_scaling": "animation.hoglin.baby_scaling",
    "ghost_corpse": "animation.ghost.corpse.zoglin",
    "ghost_corpse_ctrl": "controller.animation.ghost.corpse"
   },
   "render_controllers": [
    "controller.render.zoglin.v2",
    {
     "controller.render.ghost_eyes": "!query.property('ghost:corpse')"
    }
   ]
  }
 }
}