{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "ghost:vessel_chicken",
   "materials": {
    "default": "chicken",
    "legs": "chicken_legs",
    "cold": "chicken_cold",
    "ghost_eyes": "breeze_eyes"
   },
   "textures": {
    "default": "textures/entity/chicken/chicken",
    "warm": "textures/entity/chicken/chicken_warm",
    "cold": "textures/entity/chicken/chicken_cold",
    "baby_default": "textures/entity/chicken/chicken_temperate_baby",
    "baby_warm": "textures/entity/chicken/chicken_warm_baby",
    "baby_cold": "textures/entity/chicken/chicken_cold_baby",
    "ghost_eyes": "textures/entity/ghost_eyes"
   },
   "geometry": {
    "default": "geometry.ghost.chicken.default",
    "warm": "geometry.ghost.chicken.warm",
    "cold": "geometry.ghost.chicken.cold",
    "baby": "geometry.ghost.chicken.baby",
    "ghost_eyes": "geometry.ghost.chicken.eyes"
   },
   "animations": {
    "move": "animation.chicken.move",
    "general": "animation.chicken.general",
    "look_at_target": "animation.common.look_at_target",
    "baby_transform": "animation.chicken.baby_transform",
    "ghost_corpse": "animation.ghost.corpse.chicken",
    "ghost_corpse_ctrl": "controller.animation.ghost.corpse"
   },
   "scripts": {
    "animate": [
     "general",
     {
      "move": "query.modified_move_speed"
     },
     "look_at_target",
     "ghost_corpse_ctrl"
    ],
    "pre_animation": [
     "t.variant = 'temperate';",
     "v.index = (t.variant == 'temperate') ? 0 : ((t.variant == 'warm') ? 1 : 2);",
     "v.is_cold = t.variant == 'cold';"
    ],
    "scale": "query.is_baby ? 2.0 : 1.0"
   },
   "render_controllers": [
    "controller.render.chicken.v3",
    {
     "controller.render.ghost_eyes": "!query.property('ghost:corpse')"
    }
   ]
  }
 }
}