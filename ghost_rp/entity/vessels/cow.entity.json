{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "ghost:vessel_cow",
   "materials": {
    "default": "cow",
    "cold": "cow_cold",
    "ghost_eyes": "breeze_eyes"
   },
   "textures": {
    "default": "textures/entity/cow/cow_v2",
    "warm": "textures/entity/cow/cow_warm",
    "cold": "textures/entity/cow/cow_cold",
    "baby_default": "textures/entity/cow/cow_temperate_baby",
    "baby_cold": "textures/entity/cow/cow_cold_baby",
    "baby_warm": "textures/entity/cow/cow_warm_baby",
    "ghost_eyes": "textures/entity/ghost_eyes"
   },
   "geometry": {
    "default": "geometry.ghost.cow.default",
    "warm": "geometry.ghost.cow.warm",
    "cold": "geometry.ghost.cow.cold",
    "baby": "geometry.ghost.cow.baby",
    "ghost_eyes": "geometry.ghost.cow.eyes"
   },
   "animations": {
    "setup": "animation.cow.setup",
    "walk": "animation.quadruped.walk",
    "look_at_target": "animation.common.look_at_target",
    "baby_transform": "animation.cow.baby_transform",
    "ghost_corpse": "animation.ghost.corpse.cow",
    "ghost_corpse_ctrl": "controller.animation.ghost.corpse"
   },
   "scripts": {
    "animate": [
     "setup",
     {
      "walk": "query.modified_move_speed"
     },
     "look_at_target",
     "ghost_corpse_ctrl"
    ],
    "pre_animation": [
     "t.variant = 'temperate';",
     "v.index = (t.variant == 'temperate') ? 0 : ((t.variant == 'warm') ? 1 : 2);",
     "v.is_cold = t.variant == 'cold';"
    ],
    "scale": "query.is_baby ? 2.0 : 1.0"
   },
   "render_controllers": [
    "controller.render.cow.v3",
    {
     "controller.render.ghost_eyes": "!query.property('ghost:corpse')"
    }
   ]
  }
 }
}