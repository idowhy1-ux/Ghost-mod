{
 "format_version": "1.8.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "ghost:vessel_cod",
   "materials": {
    "default": "cod",
    "ghost_eyes": "breeze_eyes"
   },
   "textures": {
    "default": "textures/entity/fish/cod",
    "ghost_eyes": "textures/entity/ghost_eyes"
   },
   "geometry": {
    "default": "geometry.ghost.cod.default",
    "ghost_eyes": "geometry.ghost.cod.eyes"
   },
   "scripts": {
    "pre_animation": [
     "variable.ZRot = !query.is_in_water ? Math.cos((query.time_stamp + query.frame_alpha) * 14.32) * 90 : 0.0;",
     "variable.AnimationAmountBlend = Math.lerp(variable.AnimationAmountPrev, variable.AnimationAmount, query.frame_alpha);"
    ]
   },
   "animations": {
    "flop": "animation.cod.flop",
    "swim": "animation.cod.swim",
    "ghost_corpse": "animation.ghost.corpse.cod"
   },
   "animation_controllers": [
    {
     "general": "controller.animation.fish.general"
    },
    {
     "ghost_corpse_ctrl": "controller.animation.ghost.corpse"
    }
   ],
   "render_controllers": [
    "controller.render.cod",
    {
     "controller.render.ghost_eyes": "!query.property('ghost:corpse')"
    }
   ]
  }
 }
}