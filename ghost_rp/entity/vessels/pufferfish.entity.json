{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "ghost:vessel_pufferfish",
   "materials": {
    "default": "pufferfish",
    "ghost_eyes": "breeze_eyes"
   },
   "textures": {
    "default": "textures/entity/fish/pufferfish",
    "ghost_eyes": "textures/entity/ghost_eyes"
   },
   "geometry": {
    "default": "geometry.ghost.pufferfish.default",
    "mid": "geometry.ghost.pufferfish.mid",
    "large": "geometry.ghost.pufferfish.large",
    "ghost_eyes": "geometry.ghost.pufferfish.eyes"
   },
   "scripts": {
    "pre_animation": [
     "variable.ZRot = !query.is_in_water ? Math.cos(query.time_stamp * 14.32) * 90 : 0.0;",
     "variable.AnimationAmountBlend = Math.lerp(variable.AnimationAmountPrev, variable.AnimationAmount, query.frame_alpha);"
    ],
    "animate": [
     "general",
     "ghost_corpse_ctrl"
    ]
   },
   "animations": {
    "flop": "animation.pufferfish.flop",
    "swim": "animation.pufferfish.swim",
    "general": "controller.animation.fish.general",
    "ghost_corpse": "animation.ghost.corpse.pufferfish",
    "ghost_corpse_ctrl": "controller.animation.ghost.corpse"
   },
   "render_controllers": [
    {
     "controller.render.pufferfish.small": "query.variant == 0"
    },
    {
     "controller.render.pufferfish.medium": "query.variant == 1"
    },
    {
     "controller.render.pufferfish.large": "query.variant == 2"
    },
    {
     "controller.render.ghost_eyes": "!query.property('ghost:corpse')"
    }
   ]
  }
 }
}