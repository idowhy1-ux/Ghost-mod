{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "ghost:vessel_bee",
   "materials": {
    "default": "bee",
    "ghost_eyes": "breeze_eyes"
   },
   "textures": {
    "default": "textures/entity/bee/bee",
    "angry": "textures/entity/bee/bee_angry",
    "nectar": "textures/entity/bee/bee_nectar",
    "angry_nectar": "textures/entity/bee/bee_angry_nectar",
    "baby_default": "textures/entity/bee/bee_baby",
    "baby_angry": "textures/entity/bee/bee_angry_baby",
    "baby_nectar": "textures/entity/bee/bee_nectar_baby",
    "baby_angry_nectar": "textures/entity/bee/bee_angry_nectar_baby",
    "ghost_eyes": "textures/entity/ghost_eyes"
   },
   "geometry": {
    "default": "geometry.ghost.bee.default",
    "baby": "geometry.ghost.bee.baby",
    "ghost_eyes": "geometry.ghost.bee.eyes"
   },
   "animations": {
    "flying": "animation.bee.flying",
    "drip": "controller.animation.ghost.bee.bee.drip",
    "controller_bee_sting": "controller.animation.bee.sting",
    "bee_sting": "animation.bee.sting",
    "bee_no_stinger": "animation.bee.no_stinger",
    "bee_fly_bobbing": "animation.bee.fly.bobbing",
    "bee_root_controller": "controller.animation.bee.root",
    "ghost_corpse": "animation.ghost.corpse.bee",
    "ghost_corpse_ctrl": "controller.animation.ghost.corpse"
   },
   "particle_effects": {
    "nectar_dripping": "minecraft:nectar_drip_particle"
   },
   "scripts": {
    "animate": [
     "bee_root_controller",
     {
      "bee_no_stinger": "query.mark_variant == 1"
     },
     "ghost_corpse_ctrl"
    ],
    "scale": "query.is_baby ? 2.0 : 1.0"
   },
   "render_controllers": [
    "controller.render.ghost.bee.bee.v2",
    {
     "controller.render.ghost_eyes": "!query.property('ghost:corpse')"
    }
   ]
  }
 }
}