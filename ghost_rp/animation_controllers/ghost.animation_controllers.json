{
 "format_version": "1.10.0",
 "animation_controllers": {
  "controller.animation.ghost.corpse": {
   "initial_state": "alive",
   "states": {
    "alive": {
     "transitions": [
      {
       "dead": "query.property('ghost:corpse')"
      }
     ],
     "blend_transition": 0.6
    },
    "dead": {
     "animations": [
      "ghost_corpse"
     ],
     "transitions": [
      {
       "alive": "!query.property('ghost:corpse')"
      }
     ],
     "blend_transition": 0.6
    }
   }
  },
  "controller.animation.ghost.bee.bee.drip": {
   "initial_state": "default",
   "states": {
    "default": {
     "transitions": [
      {
       "dripping": "0.0"
      }
     ]
    },
    "dripping": {
     "particle_effects": [
      {
       "effect": "nectar_dripping"
      }
     ],
     "transitions": [
      {
       "default": "!0.0"
      }
     ]
    }
   }
  }
 }
}