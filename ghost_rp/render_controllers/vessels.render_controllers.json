{
 "format_version": "1.10.0",
 "render_controllers": {
  "controller.render.ghost.bee.bee.v2": {
   "arrays": {
    "textures": {
     "array.skins": [
      "texture.default",
      "texture.nectar",
      "texture.angry",
      "texture.angry_nectar"
     ],
     "array.baby_skins": [
      "texture.baby_default",
      "texture.baby_nectar",
      "texture.baby_angry",
      "texture.baby_angry_nectar"
     ]
    }
   },
   "geometry": "query.is_baby ? Geometry.baby : Geometry.default",
   "materials": [
    {
     "*": "Material.default"
    }
   ],
   "textures": [
    "query.is_baby ? array.baby_skins[0.0 + query.is_angry * 2] : array.skins[0.0 + query.is_angry * 2]"
   ]
  }
 }
}