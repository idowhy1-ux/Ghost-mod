{
  "format_version": "1.8.0",
  "animations": {
    "animation.ghost.lost_soul.float": {
      "loop": true,
      "bones": {
        "root": {
          "position": [ 0, "math.sin(query.life_time * 120) * 1.5", 0 ]
        },
        "tail": {
          "rotation": [ "math.sin(query.life_time * 200) * 12", 0, "math.cos(query.life_time * 160) * 10" ]
        },
        "right_arm": {
          "rotation": [ "-50 + math.sin(query.life_time * 150) * 15", 0, 0 ]
        },
        "left_arm": {
          "rotation": [ "-50 - math.sin(query.life_time * 150) * 15", 0, 0 ]
        }
      }
    }
  }
}
